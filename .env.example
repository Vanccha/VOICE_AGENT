# ==========================================================
#  TÜM PROJELER İÇİN TEK API ANAHTARI
#  Bu dosyayı ".env" adıyla kopyala ve anahtarını yaz.
#  (.env dosyası .gitignore'da, GitHub'a gönderilmez)
# ==========================================================
OPENAI_API_KEY=buraya_api_anahtarini_yaz

# --- İsteğe bağlı ayarlar (boş bırakırsan varsayılanlar kullanılır) ---
# Pipeline projelerinde (01-07) asistanın sesi: alloy, ash, ballad, coral, echo, fable, onyx, nova, sage, shimmer, verse, marin, cedar
ASISTAN_SESI=coral
# Pipeline projelerinde cevapları üreten metin modeli
METIN_MODELI=gpt-4.1-mini
# Realtime projelerinde (08-10) kullanılan model (ucuz seçenek: gpt-realtime-2.1-mini)
REALTIME_MODELI=gpt-realtime
